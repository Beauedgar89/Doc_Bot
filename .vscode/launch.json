{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: ingest.py (Results in Debug Console)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ingest.py",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "justMyCode": true
        },
        {
            "name": "Python: Current File (Results in Debug Console)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "justMyCode": true
        }
    ]
}